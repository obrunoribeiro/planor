# Copie para .env e preencha. Nunca commitar o .env de verdade (ver .gitignore).

# ---- Supabase (apps/api) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---- Supabase (apps/mobile) ----
# Mesma URL e anon key de cima — o prefixo EXPO_PUBLIC_ é o jeito do Expo expor uma env var pro
# bundle do app (nunca ponha a service_role aqui, essa é só server-side).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Open Finance — Pluggy (apps/api) ----
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Header secreto que a gente mesmo define ao registrar o webhook no Pluggy — não é assinatura
# criptográfica (o Pluggy não assina payload de webhook), só um "X-Planor-Webhook-Secret" que
# a gente confere bate na entrada (ver apps/api/src/routes/connections.ts).
PLUGGY_WEBHOOK_SECRET=
# URL pública da sua API (ngrok ou deploy) — o Pluggy precisa alcançar /webhooks/aggregator de
# fora da rede local. Muda toda vez que o ngrok reinicia (ver CONTRIBUTING.md).
PLUGGY_WEBHOOK_BASE_URL=

# ---- IA — Anthropic via Vercel AI SDK (apps/api) ----
ANTHROPIC_API_KEY=

# ---- Assinaturas — RevenueCat (apps/api) ----
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# ---- Observabilidade ----
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ---- Compartilhamento — App ID da Meta (stories do Instagram) ----
META_APP_ID=

# ---- apps/mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://localhost:3333
